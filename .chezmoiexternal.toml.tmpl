{{- else }}
    # Pinned to v10.3 for Fish 3.x compatibility on Linux (v11.0+ requires Fish 4.0)
    url = "https://github.com/patrickf1/fzf.fish/archive/8920367cf85eee5218cc25a11e209d46e2591e7a.tar.gz" # v10.3
{{- end }}
    exact = true
    stripComponents = 1
    include = ["*/conf.d/**", "*/functions/**", "*/completions/**"]
