#!/opt/homebrew/bin/fish

if not test -f /etc/pam.d/sudo_local
    sed 's/^#auth/auth/' /etc/pam.d/sudo_local.template | sudo tee /etc/pam.d/sudo_local >/dev/null
else if not grep -Eq '^auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so' /etc/pam.d/sudo_local
    echo 'auth       sufficient     pam_tid.so' | sudo tee -a /etc/pam.d/sudo_local >/dev/null
end

sudo scutil --set HostName {{ .hostname | quote }}
sudo scutil --set ComputerName {{ .hostname | quote }}
sudo scutil --set LocalHostName {{ .hostname | quote }}

sudo nvram StartupMute=%01
