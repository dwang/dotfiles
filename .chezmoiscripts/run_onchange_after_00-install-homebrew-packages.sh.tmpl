#!/usr/bin/env bash
set -euo pipefail

# Brewfile hash: {{ include "private_dot_config/homebrew/Brewfile" | sha256sum }}

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

[[ -x "/opt/homebrew/bin/brew" ]] || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

eval "$(/opt/homebrew/bin/brew shellenv)"

brew bundle cleanup --install --force --global
